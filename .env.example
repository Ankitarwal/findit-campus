# ==============================================================================
# FindIt Campus — Environment Variables Configuration
# ==============================================================================

# Client-Side Variables (Vite public prefix VITE_)
# Supabase Project Configuration (From your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# (Alias supported for backward compatibility)
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Gemma 4 AI Configuration (Public model name and API endpoints)
VITE_GEMMA_MODEL=gemma-4-26b-a4b-it
VITE_GEMMA_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# ==============================================================================
# Server-Side Secrets for Supabase Edge Functions (Set via `supabase secrets set`)
# DO NOT PREFIX WITH VITE_ AND NEVER COMMIT REAL KEYS TO GIT
# ==============================================================================
# GEMMA_API_KEY=sk-or-v1-...
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
